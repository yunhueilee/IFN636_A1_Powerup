# PowerUp backend configuration.
# The backend loads this file from the repo root (see backend/src/config/env.ts).
# Copy to `.env` and fill in real values. Never commit `.env`.

# MongoDB connection string (Atlas). Replace <user> and <password>.
MONGODB_URI=mongodb+srv://<user>:<password>@powerup.cgnoswj.mongodb.net/powerup?retryWrites=true&w=majority&appName=powerup

# Port the API listens on. Must be open as an inbound rule in the EC2 security group.
PORT=5001

# Secret used to sign JWTs. Generate a long random value for EC2, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long issued tokens stay valid.
JWT_EXPIRES_IN=7d
