# PowerUp mobile app configuration (Expo loads this file automatically).
# Copy to `.env` and set the URL that matches where you run the app.
# Only EXPO_PUBLIC_* vars are exposed to the client bundle.

# Local testing on the same machine (web / iOS simulator / Android emulator via adb reverse):
#   EXPO_PUBLIC_API_URL=http://localhost:5001/api
# Local testing on a physical device (use your computer's LAN IP):
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:5001/api
# EC2 deployment (port 5001 must be open in the security group):
EXPO_PUBLIC_API_URL=http://<EC2_PUBLIC_IP>:5001/api
